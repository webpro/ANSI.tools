{
  "name": "@ansi-tools/parser",
  "version": "1.0.15",
  "description": "Tokenize and parse strings containing ANSI escape sequences and control codes",
  "keywords": [
    "ansi",
    "escape codes",
    "web application"
  ],
  "homepage": "https://github.com/webpro/ANSI.tools/tree/main/packages/parser",
  "bugs": "https://github.com/webpro/ANSI.tools/issues",
  "license": "ISC",
  "author": "Lars Kappert <lars@webpro.nl>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/webpro/ANSI.tools.git",
    "directory": "packages/parser"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./escaped": {
      "types": "./dist/escaped.d.mts",
      "import": "./dist/escaped.mjs",
      "default": "./dist/escaped.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prebuild": "pnpm type-check && pnpm test",
    "build": "tsdown --dts --minify src/index.ts src/escaped.ts",
    "dev": "tsdown --dts src/index.ts src/escaped.ts --watch",
    "gen": "node scripts/gen-tokenize.ts",
    "pretest": "pnpm gen && git diff --exit-code -- src/tokenize.gen.ts src/tokenize.escaped.gen.ts",
    "test": "node --import ./test/assertions.ts --test",
    "type-check": "tsc --noEmit",
    "check-pack": "node scripts/check-pack.ts",
    "lint:publish": "publint --strict",
    "prepack": "pnpm build && pnpm lint:publish && pnpm check-pack"
  },
  "devDependencies": {
    "@types/node": "^24.12.4",
    "mitata": "^1.0.34",
    "publint": "^0.3.21",
    "tsdown": "^0.22.0",
    "typescript": "^6.0.3"
  }
}
